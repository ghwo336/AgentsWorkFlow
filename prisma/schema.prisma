generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A first-class project: groups runs and can exist before any run is created.
/// Runs reference it by name (Run.project). Created explicitly from the
/// dashboard, or auto-created (upserted) when a run names a new project.
model Project {
  name             String   @id
  defaultTargetDir String? // default repo dir pre-filled for new runs in this project
  createdAt        DateTime @default(now())
}

/// One end-to-end task: brief -> plan -> build -> verify -> commit
model Run {
  id        String   @id @default(cuid())
  project   String   @default("default") // logical project this run belongs to (for grouping costs)
  title     String
  brief     String // the original planning input from the user
  status    String   @default("planning") // planning | awaiting_approval | building | verifying | committed | rejected | failed | cancelled
  plan      String? // approved plan text (from Opus)
  planSteps String? // JSON array of decomposed plan-step descriptions (for restart-safe resume)
  targetDir String? // working copy path for this run
  commit    String? // final commit hash on success
  error     String? // terminal error message, if any
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   Event[]
  verdicts Verdict[]
  usages   Usage[]
  steps    Step[]
  chatMsgs ChatMsg[]

  @@index([project])
}

/// One agent's unit of work within a run (a "span"): plan, a single build
/// attempt, a reviewer pass, a test run, etc. Unlike Event (point-in-time log)
/// it has a lifecycle — start/end timestamps + status — and an optional parent,
/// so the dashboard can render the same data as a list, kanban, node graph
/// (parentId = edge), or timeline/gantt (startedAt→endedAt = bar).
model Step {
  id        String    @id @default(cuid())
  runId     String
  run       Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  parentId  String? // DAG edge for the node graph; null = root
  kind      String // plan | build | verify | review | test | commit
  label     String // human name, e.g. "계획", "빌드 시도 2", "리뷰어: codex"
  engine    String? // claude | codex | null (system)
  model     String?
  attempt   Int       @default(1)
  status    String    @default("running") // pending | running | passed | failed | skipped
  summary   String? // one-line result blurb
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  orderIdx  Int       @default(0)

  @@index([runId])
  @@index([parentId])
}

/// One model invocation's token usage, with the API-equivalent cost in USD.
/// Codex runs on a ChatGPT subscription (no API billing) — its cost is the
/// hypothetical API-rate equivalent, for apples-to-apples comparison.
model Usage {
  id           String   @id @default(cuid())
  runId        String
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  engine       String // "claude" | "codex"
  model        String // e.g. claude-opus-4-8, claude-sonnet-4-6, gpt-5.5
  phase        String // plan | build | verify
  inputTokens  Int      @default(0) // uncached input tokens
  outputTokens Int      @default(0)
  cacheRead    Int      @default(0) // cached input tokens (read)
  cacheWrite   Int      @default(0) // cache-creation tokens (write)
  costUsd      Float    @default(0) // API-equivalent cost in USD, computed at record time
  stepId       String? // the Step this usage is attributed to, if any
  ts           DateTime @default(now())

  @@index([runId])
  @@index([stepId])
}

/// Append-only timeline of everything that happens in a run.
model Event {
  id      String   @id @default(cuid())
  runId   String
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase   String // plan | approval | build | verify | commit | system
  level   String   @default("info") // info | warn | error
  model   String? // opus | sonnet | codex | null
  message String
  stepId  String? // the Step this log line belongs to, if any
  ts      DateTime @default(now())

  @@index([runId])
  @@index([stepId])
}

/// Each codex verification attempt, including rejections with full reason.
model Verdict {
  id      String   @id @default(cuid())
  runId   String
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt Int // 1-based verify attempt number
  passed  Boolean
  reason  String // codex's full explanation (esp. rejection reason)
  diff    String? // snapshot of the diff that was reviewed
  raw     String? // raw codex JSON output, for debugging
  stepId  String? // the review Step this verdict belongs to, if any
  ts      DateTime @default(now())

  @@index([runId])
  @@index([stepId])
}

/// Team chat: the agents' conversation as they work a step (구현→검증→구현 loop,
/// 호재 escalation, user guidance). Derived from each agent's real output so the
/// user can watch them talk it through. `role`+`attempt` resolve to the same
/// pixel character the step avatars use.
model ChatMsg {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  role      String // plan | build | verify | system | user (who is speaking)
  attempt   Int      @default(1) // resolves which build/verify teammate (태경 vs 민재 …)
  kind      String // build | verify | escalate | guide | commit | note
  toRole    String? // addressee role (for "→ 개발팀" style), if any
  stepLabel String? // "단계 4/7"
  passed    Boolean? // for verify turns: did it pass?
  text      String
  ts        DateTime @default(now())

  @@index([runId])
}
